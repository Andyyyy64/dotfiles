// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // ===== パネル配置を VS Code / Cursor に合わせる =====
  // 左サイドバー: エクスプローラ / ソース管理 / アウトライン
  // (Zed の既定は project_panel も outline_panel も git_panel も "right")
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  // 右サイドバー: AI チャット (Cursor の Chat と同じ位置。Zed の既定は "left")
  "agent": {
    "dock": "right"
  },
  // 下パネルを左右のサイドバーの下に潜らせない (VS Code と同じ)
  "bottom_dock_layout": "contained",
  // エディタ分割は右に開く (VS Code の cmd-\ と同じ挙動)
  "pane_split_direction_vertical": "right",
  // タブにファイルアイコンと git 色を出す (Zed の既定は両方 false)
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  // ミニマップ (Zed の既定は "never")
  "minimap": {
    "show": "auto"
  },
  "icon_theme": "Zed (Default)",
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "terminal": {
    // Claude Code の option+enter (改行) を通すため
    "option_as_meta": true,
    // herdr がタブ全体を使うのでパンくずは不要
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
}
